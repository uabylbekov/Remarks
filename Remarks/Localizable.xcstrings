    "The folder and the notes in it move to Recently Deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner und die darin enthaltenen Notizen werden in „Zuletzt gelöscht“ bewegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier et les notes qu’il contient seront déplacés vers Supprimées récemment."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダと中のメモは「最近削除した項目」に移動されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더와 그 안의 노트가 최근 삭제된 항목으로 이동됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此文件夹及其中的笔记将移至“最近删除”。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此資料夾及其中的筆記將會移至「最近刪除」。"
          }
        }
      }
    },
    "The folder, its subfolders, and the notes inside move to Recently Deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Der Ordner, seine Unterordner und alle darin enthaltenen Notizen werden in „Zuletzt gelöscht“ bewegt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le dossier, ses sous-dossiers et les notes qu’ils contiennent seront déplacés vers Supprimées récemment."
