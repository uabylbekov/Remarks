        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォルダ、サブフォルダ、および中のメモは「最近削除した項目」に移動されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "폴더, 하위 폴더 및 그 안의 노트가 최근 삭제된 항목으로 이동됩니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
