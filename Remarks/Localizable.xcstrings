          }
        }
      }
    },
    "Titles, previews, and tags are added to Spotlight and Siri. The full text of a note is never shared." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Titel, Vorschauen und Tags werden zu Spotlight und Siri hinzugefügt. Der vollständige Text einer Notiz wird niemals geteilt."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les titres, aperçus et tags sont ajoutés à Spotlight et Siri. Le texte intégral d’une note n’est jamais partagé."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "タイトル、プレビュー、タグがSpotlightとSiriに追加されます。メモの全文が共有されることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "제목, 미리보기 및 태그가 Spotlight와 Siri에 추가됩니다. 노트 본문 전체는 절대 공유되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "标题、摘要和标签会添加到聚焦和 Siri。笔记全文绝不会被共享。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "標題、預覽與標籤會加入 Spotlight 與 Siri。筆記全文絕不會被分享。"
          }
        }
