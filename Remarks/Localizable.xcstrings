          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Schrift ist auf diesem Gerät nicht installiert; stattdessen wird die Systemschrift verwendet."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cette police n’est pas installée sur cet appareil ; la police système est donc utilisée."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このフォントはこのデバイスにインストールされていないため、システムフォントが使用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 기기에 해당 서체가 설치되어 있지 않아 시스템 서체를 대신 사용합니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
