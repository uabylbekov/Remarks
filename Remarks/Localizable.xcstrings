    "This tag will be removed from all notes. Your notes won’t be deleted." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dieses Tag wird aus allen Notizen entfernt. Deine Notizen werden nicht gelöscht."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce tag sera retiré de toutes les notes. Vos notes ne seront pas supprimées."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このタグはすべてのメモから削除されます。メモ自体は削除されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 태그는 모든 노트에서 제거됩니다. 노트는 삭제되지 않습니다."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此标签将从所有笔记中移除。你的笔记不会被删除。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
